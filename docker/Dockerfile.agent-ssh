# syntax=docker/dockerfile:1.20
# SSH-accessible remote agent container for Paperclip.
# The Paperclip server SSHes into this container to execute agent heartbeats.
#
# Usage: built as part of docker-compose.prod.yml agent services.
# SSH access is restricted to key-based auth only.
# Pass the public key via AGENT_AUTHORIZED_KEY env var at runtime.

FROM node:lts-trixie-slim

ARG AGENT_USER=agent
ARG AGENT_UID=2000
ARG AGENT_GID=2000

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    openssh-server git gh curl wget ripgrep ca-certificates procps python3 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.12 /uv /uvx /usr/local/bin/

# Create agent user/group
RUN groupadd -g ${AGENT_GID} ${AGENT_USER} \
  && useradd -u ${AGENT_UID} -g ${AGENT_GID} -m -s /bin/bash ${AGENT_USER}

# Install agent CLIs globally
RUN npm install -g \
  @anthropic-ai/claude-code@latest \
  @openai/codex@latest \
  opencode-ai \
  agent-browser \
  @toolbox-sdk/server@latest \
  @customerio/cli@latest

# System libraries required by agent-browser's Chromium
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libgbm1 \
    libgtk-3-0 libxkbcommon0 libxss1 libasound2 libx11-6 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxrandr2 libxrender1 libxtst6 \
    fonts-liberation xdg-utils \
  && rm -rf /var/lib/apt/lists/*

# Install agent-browser binary and skill as agent user
USER ${AGENT_USER}
RUN agent-browser install
RUN npx skills add vercel-labs/agent-browser --yes --global || true
USER root

# Generate SSH host keys and configure sshd
RUN mkdir -p /run/sshd \
  && ssh-keygen -A \
  && echo "PasswordAuthentication no" >> /etc/ssh/sshd_config \
  && echo "ChallengeResponseAuthentication no" >> /etc/ssh/sshd_config \
  && echo "UsePAM no" >> /etc/ssh/sshd_config \
  && echo "X11Forwarding no" >> /etc/ssh/sshd_config \
  && echo "PrintMotd no" >> /etc/ssh/sshd_config \
  && echo "AcceptEnv *" >> /etc/ssh/sshd_config \
  && echo "Subsystem sftp /usr/lib/openssh/sftp-server" >> /etc/ssh/sshd_config

# Create workspace and SSH authorized_keys dir for agent user
RUN mkdir -p /home/${AGENT_USER}/.ssh /workspace \
  && chown -R ${AGENT_USER}:${AGENT_USER} /home/${AGENT_USER}/.ssh /workspace \
  && chmod 700 /home/${AGENT_USER}/.ssh

EXPOSE 22

VOLUME ["/workspace"]

COPY scripts/docker-agent-entrypoint.sh /usr/local/bin/
COPY scripts/docker-agent-entrypoint-setup.sh /usr/local/bin/
COPY scripts/docker-mcp-bootstrap.sh /usr/local/bin/
COPY scripts/docker-customerio-bootstrap.sh /usr/local/bin/
COPY scripts/write-gcp-mcp-config.mjs /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-agent-entrypoint.sh /usr/local/bin/docker-agent-entrypoint-setup.sh /usr/local/bin/docker-mcp-bootstrap.sh /usr/local/bin/docker-customerio-bootstrap.sh

ENTRYPOINT ["docker-agent-entrypoint.sh"]
